  "html_template": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"ar\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>بطاقة صيانة رقم {{id}}</title>\n  <style>\n    body {\n      font-family: 'Arial', sans-serif;\n      margin: 0;\n      padding: 15px;\n      direction: rtl;\n      color: #333;\n      background-color: #fff;\n    }\n    .container {\n      border: 2px solid #1a202c;\n      padding: 20px;\n      max-width: 800px;\n      margin: 0 auto;\n      border-radius: 6px;\n    }\n    .header {\n      text-align: center;\n      border-bottom: 2px double #1a202c;\n      padding-bottom: 15px;\n      margin-bottom: 20px;\n    }\n    .header h1 {\n      margin: 0;\n      font-size: 24px;\n      color: #1a202c;\n    }\n    .header p {\n      margin: 5px 0 0;\n      font-size: 14px;\n      color: #4a5568;\n    }\n    .section-title {\n      font-size: 16px;\n      font-weight: bold;\n      background: #edf2f7;\n      padding: 8px 12px;\n      margin-top: 20px;\n      margin-bottom: 10px;\n      border-right: 4px solid #3182ce;\n      border-radius: 0 4px 4px 0;\n    }\n    .grid-info {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 15px;\n      margin-bottom: 20px;\n    }\n    .info-item {\n      display: flex;\n      border-bottom: 1px dashed #cbd5e0;\n      padding-bottom: 5px;\n    }\n    .info-label {\n      font-weight: bold;\n      min-width: 120px;\n      color: #2d3748;\n    }\n    .info-value {\n      color: #4a5568;\n    }\n    table.maint-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 15px;\n      margin-bottom: 25px;\n    }\n    table.maint-table th, table.maint-table td {\n      border: 1px solid #1a202c;\n      padding: 10px;\n      text-align: right;\n      vertical-align: top;\n      font-size: 14px;\n    }\n    table.maint-table th {\n      background-color: #edf2f7;\n      font-weight: bold;\n      color: #2d3748;\n    }\n    .signatures-section {\n      margin-top: 30px;\n    }\n    .signatures-grid {\n      display: grid;\n      grid-template-columns: minmax(200px, 300px);\n      gap: 15px;\n      margin-top: 15px;\n    }\n    .sig-box {\n      border: 1px solid #718096;\n      border-radius: 4px;\n      padding: 8px;\n      text-align: center;\n      min-height: 80px;\n    }\n    .sig-title {\n      font-weight: bold;\n      border-bottom: 1px solid #cbd5e0;\n      padding-bottom: 5px;\n      margin-bottom: 15px;\n      color: #2d3748;\n    }\n    .sig-value {\n      font-style: italic;\n      color: #2b6cb0;\n      font-size: 14px;\n      font-weight: bold;\n    }\n    .exit-date {\n      margin-bottom: 15px;\n      font-weight: bold;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>بطاقة صيانة المركبة للورشة الفنية</h1>\n      <p>نظام إدارة ومتابعة البطاقات الفنية الموحدة</p>\n    </div>\n\n    <div class=\"section-title\">الجزء الأول: البيانات الأساسية لبطاقة الدخول</div>\n    <div class=\"grid-info\">\n      <div class=\"info-item\">\n        <span class=\"info-label\">الرقم التسلسلي:</span>\n        <span class=\"info-value\" style=\"font-weight: bold;\">{{id}}</span>\n      </div>\n      <div class=\"info-item\">\n        <span class=\"info-label\">رقم المركبة:</span>\n        <span class=\"info-value\">{{vehicle_id}}</span>\n      </div>\n      <div class=\"info-item\">\n        <span class=\"info-label\">رقم المقطورة:</span>\n        <span class=\"info-value\">{{trailer_id}}</span>\n      </div>\n      <div class=\"info-item\">\n        <span class=\"info-label\">اسم السائق:</span>\n        <span class=\"info-value\">{{driver_name}}</span>\n      </div>\n      <div class=\"info-item\">\n        <span class=\"info-label\">تاريخ الدخول:</span>\n        <span class=\"info-value\">{{date_in}}</span>\n      </div>\n      <div class=\"info-item\">\n        <span class=\"info-label\">نوع العطب:</span>\n        <span class=\"info-value\">{{damage_type}}</span>\n      </div>\n    </div>\n\n    <div class=\"section-title\">الجزء الثاني: جدول الصيانة وقطع الغيار</div>\n    <table class=\"maint-table\">\n      <thead>\n        <tr>\n          <th style=\"width: 25%;\">قطع الغيار المستبدل</th>\n          <th style=\"width: 25%;\">إصلاح العطب</th>\n          <th style=\"width: 25%;\">تشخيص الميكانيكي</th>\n          <th style=\"width: 25%;\">طاقم العمل والمسؤول</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>{{parts}}</td>\n          <td>{{repair_details}}</td>\n          <td>{{diagnosis}}</td>\n          <td>{{work_team}}<br/><span style=\"display: inline-block; margin-top: 5px; font-size: 12px; color: #4a5568;\"><strong>العامل المنفذ:</strong> {{worker_name}}</span></td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"section-title\">الجزء الثالث: اعتماد خروج المركبة والتواقيع</div>\n    <div class=\"signatures-section\">\n      <div class=\"exit-date\">تاريخ الخروج المعتمد: <span style=\"font-weight: normal; margin-right: 10px;\">{{date_out}}</span></div>\n      <div class=\"signatures-grid\">\n        <div class=\"sig-box\">\n          <div class=\"sig-title\">مسؤول الورشة الفنية المباشر</div>\n          <div class=\"sig-value\">{{signature_manager}}</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
  "daily_report_template": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"ar\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>تقرير الصيانة اليومي - تاريخ {{target_date}}</title>\n  <style>\n    body {\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      margin: 0;\n      padding: 25px;\n      background-color: #fff;\n      color: #1e293b;\n      direction: rtl;\n    }\n    .report-container {\n      border: 3px double #0f172a;\n      padding: 30px;\n      border-radius: 12px;\n      max-width: 1000px;\n      margin: 0 auto;\n      position: relative;\n    }\n    .header-box {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 2px solid #0f172a;\n      padding-bottom: 15px;\n      margin-bottom: 25px;\n    }\n    .header-title {\n      text-align: center;\n      flex: 1;\n    }\n    .header-title h1 {\n      font-size: 22px;\n      margin: 0 0 5px 0;\n      color: #0f172a;\n      font-weight: 900;\n    }\n    .header-title p {\n      font-size: 13px;\n      color: #475569;\n      margin: 0;\n      font-weight: 600;\n    }\n    .side-branding {\n      font-size: 11px;\n      color: #64748b;\n      line-height: 1.5;\n      font-weight: bold;\n    }\n    .stats-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 15px;\n      margin-bottom: 25px;\n    }\n    .stat-card {\n      background-color: #f8fafc;\n      border: 1px solid #cbd5e1;\n      border-radius: 8px;\n      padding: 12px;\n      text-align: center;\n    }\n    .stat-num {\n      font-size: 22px;\n      font-weight: 800;\n      color: #1d4ed8;\n    }\n    .stat-label {\n      font-size: 11px;\n      font-weight: bold;\n      color: #475569;\n      margin-top: 4px;\n    }\n    .table-title {\n      font-size: 14px;\n      font-weight: 850;\n      color: #0f172a;\n      margin-bottom: 12px;\n      background-color: #f1f5f9;\n      padding: 6px 12px;\n      border-right: 4px solid #1d4ed8;\n    }\n    .report-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-bottom: 30px;\n    }\n    .report-table th, .report-table td {\n      border: 1px solid #94a3b8;\n      padding: 8px 10px;\n      font-size: 11.5px;\n      text-align: right;\n      vertical-align: top;\n    }\n    .report-table th {\n      background-color: #f1f5f9;\n      font-weight: bold;\n      color: #0f172a;\n    }\n    .badge {\n      display: inline-block;\n      padding: 2px 6px;\n      border-radius: 4px;\n      font-size: 10px;\n      font-weight: bold;\n    }\n    .badge-check_in { background-color: #dbeafe; color: #1e40af; }\n    .badge-maintenance { background-color: #fef9c3; color: #854d0e; }\n    .badge-completed { background-color: #d1fae5; color: #065f46; }\n    \n    .signature-section {\n      margin-top: 45px;\n      padding-top: 20px;\n      border-top: 1px dashed #cbd5e1;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n      text-align: center;\n    }\n    .sig-box {\n      font-size: 12px;\n      color: #334155;\n    }\n    .sig-title {\n      font-weight: bold;\n      margin-bottom: 45px;\n      color: #0d172a;\n    }\n    .sig-line {\n      border-top: 1px solid #94a3b8;\n      width: 80%;\n      margin: 0 auto;\n      padding-top: 5px;\n    }\n    @media print {\n      body { padding: 0; }\n      .report-container { border: 2px solid #000; border-radius: 0; box-shadow: none; width: 100%; box-sizing: border-box; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"report-container\">\n    <div class=\"header-box\">\n      <div class=\"side-branding text-right\">\n        إدارة النقليات والوكالة العامة<br/>\n        قسم الصيانة والورشة الفنية الموحدة<br/>\n        قاعدة بيانات: النشطة والمكتملة\n      </div>\n      \n      <div class=\"header-title\">\n        <h1>التقرير الفني اليومي لحركة الورشة والتشغيل</h1>\n        <p>يوم الصيانة الفنية: <strong>{{target_date_formatted}}</strong>  •  الموافق لـ {{target_date}}</p>\n      </div>\n      \n      <div class=\"side-branding text-left\" style=\"text-align: left;\">\n        تاريخ الطباعة: {{print_date}}<br/>\n        وقت الاستخراج: {{print_time}}<br/>\n        رقم ملف السجل: {{report_ref}}\n      </div>\n    </div>\n\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-num\">{{total_active}}</div>\n        <div class=\"stat-label\">نشاط الصيانة الإجمالي</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-num\">{{new_checkins}}</div>\n        <div class=\"stat-label font-bold text-blue-600\">دخلت الورشة اليوم</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-num\" style=\"color: #10b981;\">{{completed_today}}</div>\n        <div class=\"stat-label text-emerald-500\">تم إصلاحها وغادرت اليوم</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-num\" style=\"color: #f59e0b;\">{{in_progress_today}}</div>\n        <div class=\"stat-label text-yellow-500\">قيد العمل (مستمرة للغد)</div>\n      </div>\n    </div>\n\n    <div class=\"table-title\">تفاصيل حركة وبطاقات الصيانة الفنية خلال اليوم ({{target_date}})</div>\n    \n    <table class=\"report-table\">\n      <thead>\n        <tr>\n          <th style=\"width: 10%;\">البطاقة</th>\n          <th style=\"width: 15%;\">المركبة / المقطورة</th>\n          <th style=\"width: 15%;\">اسم السائق</th>\n          <th style=\"width: 20%;\">طبيعة العطب الشاكي</th>\n          <th style=\"width: 20%;\">إجراءات وأعمال الإصلاح</th>\n          <th style=\"width: 12%;\">القطع المبدلة</th>\n          <th style=\"width: 8%;\">الحالة</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{table_rows}}\n      </tbody>\n    </table>\n\n    <div class=\"signature-section\">\n      <div class=\"sig-box\">\n        <div class=\"sig-title\">مسؤول الفرقة والمنفذ المباشر</div>\n        <div class=\"sig-line\">توقيع المعني</div>\n      </div>\n      \n      <div class=\"sig-box\">\n        <div class=\"sig-title\">مراراق الورشة ورئيس الصيانة</div>\n        <div class=\"sig-line\">الاعتماد والملاحظات</div>\n      </div>\n      \n      <div class=\"sig-box\">\n        <div class=\"sig-title\">المدير الفني المعتمد للأسطول</div>\n        <div class=\"sig-line\">المصادقة والتوجيه</div>\n      </div>\n    </div>\n    \n    <div style=\"margin-top:40px; font-size: 9.5px; text-align: center; color: #94a3b8; font-weight: bold;\">\n      * تم استخراج وطباعة هذا التقرير تلقائياً من نظام التقارير الرقمية وأرشيف الورشة ولا يعتد به رسمياً بدون التواقيع الحية والأختام المعتمدة.\n    </div>\n  </div>\n</body>\n</html>",
  "monthly_report_template": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"ar\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>تقرير الصيانة الشهري - {{month_label}}</title>\n  <style>\n    body {\n      font-family: Arial, 'Segoe UI', Tahoma, sans-serif;\n      margin: 0;\n      padding: 20px;\n      background-color: #f8fafc;\n      color: #1e293b;\n    }\n    .report-container {\n      background: white;\n      border: 2px solid #0f172a;\n      padding: 30px;\n      border-radius: 8px;\n      max-width: 1050px;\n      margin: 0 auto;\n      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);\n    }\n    .header-box {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 3px double #0f172a;\n      padding-bottom: 20px;\n      margin-bottom: 25px;\n    }\n    .header-title {\n      text-align: center;\n      flex: 1;\n    }\n    .header-title h1 {\n      font-size: 24px;\n      margin: 0;\n      color: #0f172a;\n      font-weight: 800;\n    }\n    .header-title p {\n      font-size: 14px;\n      color: #475569;\n      margin: 6px 0 0 0;\n    }\n    .side-branding {\n      font-size: 11px;\n      color: #64748b;\n      line-height: 1.5;\n      font-weight: 600;\n    }\n    .stats-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 15px;\n      margin-bottom: 30px;\n    }\n    .stat-card {\n      background-color: #f8fafc;\n      border: 1px solid #e2e8f0;\n      border-radius: 6px;\n      padding: 15px;\n      text-align: center;\n    }\n    .stat-num {\n      font-size: 26px;\n      font-weight: 800;\n      color: #2563eb;\n      margin-bottom: 4px;\n    }\n    .stat-label {\n      font-size: 12px;\n      font-weight: bold;\n      color: #475569;\n    }\n    .table-title {\n      font-size: 16px;\n      font-weight: bold;\n      color: #0f172a;\n      margin-bottom: 12px;\n      border-bottom: 2px solid #3b82f6;\n      padding-bottom: 6px;\n    }\n    .summary-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-bottom: 25px;\n    }\n    .summary-table th, .summary-table td {\n      border: 1px solid #cbd5e1;\n      padding: 8px 10px;\n      font-size: 11.5px;\n      text-align: right;\n    }\n    .summary-table th {\n      background-color: #f1f5f9;\n      font-weight: bold;\n      color: #0f172a;\n    }\n    .summary-table tr:nth-child(even) {\n      background-color: #f8fafc;\n    }\n    .signature-section {\n      margin-top: 35px;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n      text-align: center;\n    }\n    .sig-box {\n      font-size: 12px;\n      color: #334155;\n    }\n    .sig-title {\n      font-weight: bold;\n      margin-bottom: 40px;\n      color: #0f172a;\n    }\n    .sig-line {\n      border-top: 1px solid #94a3b8;\n      width: 75%;\n      margin: 0 auto;\n      padding-top: 5px;\n    }\n    @media print {\n      body {\n        padding: 0;\n        background: white;\n      }\n      .report-container {\n        box-shadow: none;\n        margin: 0;\n        border: 2px solid #000;\n        width: 100%;\n        max-width: 100%;\n        box-sizing: border-box;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"report-container\">\n    <div class=\"header-box\">\n      <div class=\"side-branding text-right\">\n        إدارة النقليات والوكالة العامة<br/>\n        قسم الصيانة والورشة الفنية الموحدة<br/>\n        أرشيف السجلات الشهرية\n      </div>\n      \n      <div class=\"header-title\">\n        <h1>تقرير الصيانة والتشغيل الشهري للورشة</h1>\n        <p>البطاقات الفنية المكتملة والمغلقة لشهر: <strong>{{month_label}}</strong></p>\n      </div>\n      \n      <div class=\"side-branding text-left\" style=\"text-align: left;\">\n        تاريخ الطباعة: {{print_date}}<br/>\n        المرجع الإحصائي: {{report_ref}}<br/>\n        الحالة: بطاقات معتمدة ومقفلة\n      </div>\n    </div>\n\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-num\">{{total_cards}}</div>\n        <div class=\"stat-label\">بطاقة صيانة مغلقة</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-num\">{{unique_vehicles}}</div>\n        <div class=\"stat-label\">مركبة تم إصلاحها</div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-num\">{{unique_drivers}}</div>\n        <div class=\"stat-label\">سائق مستفيد</div>\n      </div>\n    </div>\n\n    <div class=\"table-title\">جدول بيان بطاقات وأعمال الصيانة المنجزة خلال الشهر:</div>\n    <table class=\"summary-table\">\n      <thead>\n        <tr>\n          <th style=\"width: 12%;\">رقم البطاقة</th>\n          <th style=\"width: 15%;\">المركبة / المقطورة</th>\n          <th style=\"width: 14%;\">اسم السائق</th>\n          <th style=\"width: 18%;\">العطب والتشخيص</th>\n          <th style=\"width: 20%;\">إجراءات وأعمال الإصلاح</th>\n          <th style=\"width: 13%;\">القطع المستبدلة</th>\n          <th style=\"width: 8%;\">تاريخ الإنجاز</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{table_rows}}\n      </tbody>\n    </table>\n\n    <div class=\"signature-section\">\n      <div class=\"sig-box\">\n        <div class=\"sig-title\">مسؤول الفرقة والمنفذ المباشر</div>\n        <div class=\"sig-line\">توقيع المعني</div>\n      </div>\n      \n      <div class=\"sig-box\">\n        <div class=\"sig-title\">مراقب الورشة ورئيس الصيانة</div>\n        <div class=\"sig-line\">الاعتماد والملاحظات</div>\n      </div>\n      \n      <div class=\"sig-box\">\n        <div class=\"sig-title\">المدير الفني المعتمد للأسطول</div>\n        <div class=\"sig-line\">المصادقة والتوجيه</div>\n      </div>\n    </div>\n    \n    <div style=\"margin-top: 40px; font-size: 10px; text-align: center; color: #94a3b8; font-weight: bold; border-top: 1px dashed #cbd5e1; padding-top: 15px;\">\n      * تم استخراج واعتماد هذا التقرير الشهري الشامل تلقائياً من نظام إدارة وأرشفة الصيانة الفنية للأسطول ولا يعتد به رسمياً بدون التواقيع الحية والأختام المعتمدة.\n    </div>\n  </div>\n</body>\n</html>",
